# Ejemplo del Archivo de secretos que se usan en el App

# Booleano para permitir que un negociador suba una solicitud sin actualizar el cliente
LET_WITHOUT_UPDATE = true
# Booleano para ocultar la última actualización del negociador
HIDE_UPDATE_NEGO = false
# Prefijo de guardado de Cookies
COOKIES_PREFIX = "presyncursor"
# Booleano para determinar si mostrar el filtro de Liquidaciones
VER_FILTRO_LIQUIDACIONES = true
# Booleano para determinar si se pueden calcular los datos para todas las Referencias
PERMITIR_CALCULO_NO_ASIGNADO = false

